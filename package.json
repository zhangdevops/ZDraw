{
  "name": "zdraw",
  "version": "0.1.0",
  "description": "离线手绘白板与线框图编辑器",
  "main": "./out/main/index.js",
  "author": "ZDraw",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "notices": "node scripts/generate-notices.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "format": "prettier --write src tests scripts electron.vite.config.ts package.json tsconfig.json",
    "dist": "npm run build && npm run notices && electron-builder --win nsis --x64",
    "test": "tsx --test tests/storage.test.ts",
    "test:smoke": "npm run build && tsx tests/smoke.ts",
    "test:fullscreen": "npm run build && tsx tests/fullscreen.ts"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.zdraw.desktop",
    "productName": "ZDraw",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/0.1.0"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "package.json",
      "LICENSE",
      "licenses/**/*",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "ZDraw-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
